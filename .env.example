# Required
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# Storage and delivery
# Telegram chat IDs used by the bot
STORAGE_CHANNEL_ID=-1001234567890
POSTING_CHANNEL_ID=-1001234567891
REQUEST_LOG_CHAT_ID=-1001234567892
GENERAL_LOG_CHAT_ID=-1001234567893

# Optional ebook indexing logger settings
# These are used by the Goodreads indexing flow
STORAGE_GROUP_ID=-1001234567890
LOGGER_GROUP_ID=-1001234567894
INDEX_LOG_TOPIC_ID=12345

# Notes:
# - BOT_TOKEN is required.
# - ADMIN_IDS is a comma-separated list of Telegram user IDs.
# - Leave optional values empty if you do not use that feature.
# - STORAGE_CHANNEL_ID and STORAGE_GROUP_ID may be the same or different depending on your setup.
